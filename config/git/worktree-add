#!/bin/bash

if [ -f pnpm-lock.yaml ]; then
  echo "pnpm install"
  pnpm install --ignore-scripts
fi

if [ -f Gemfile ]; then
  echo "bundle install"
  bundle install
fi

worktrees=$(git worktree list)
root=$(echo "$worktrees" | head -1 | awk '{print $1}')
if [ -f "$root/CLAUDE.local.md" ]; then
  echo "copy CLAUDE.local.md from worktree root"
  cp "$root/CLAUDE.local.md" .
fi
if [ -f "$root/.claude/settings.local.json" ]; then
  echo "copy settings.local.json from worktree root"
  mkdir -p .claude
  cp "$root/.claude/settings.local.json" .claude/
fi
